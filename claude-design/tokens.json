{
  "name": "ForgeX",
  "version": 3,
  "source": "Extraído de la web real: src/index.css, src/components/*.tsx, src/plans.ts",
  "theme": "dark-only",
  "color": {
    "obsidiana": { "value": "#0b0a0c", "css": "--fx-obsidiana", "usage": "Fondo de página, header, franja, campos, tokens" },
    "obsidiana-card": { "value": "#121015", "css": "--fx-obsidiana-card", "usage": "Formulario, modal, panel del recorrido" },
    "obsidiana-light": { "value": "#141217", "css": "--fx-obsidiana-light", "usage": "Burbuja de chat, skeletons, resultado, hover de controles" },
    "champagne-light": { "value": "#ede4d8", "css": "--fx-champagne-light", "usage": "Texto principal (ink), precios, botón primario" },
    "champagne": { "value": "#d6c6b0", "css": "--fx-champagne", "usage": "Estado, badges, folio, íconos de lista, foco" },
    "lila-muted": { "value": "#968496", "css": "--fx-lila-muted", "usage": "Texto secundario, labels, mono, nav en reposo (5.6:1)" },
    "lila-gris": { "value": "#7a6a7a", "css": "--fx-lila-gris", "usage": "Texto >= 18px inactivo, ícono + cerrado, segmentos pasados (3.9:1)" },
    "vino": { "value": "#4a2a3a", "css": "--fx-vino", "usage": "Resplandor; tinte 30% en Max. Nunca texto" },
    "vino-light": { "value": "#663950", "css": "--fx-vino-light", "usage": "Reservado para tintes. Nunca texto" },
    "vino-glow": { "value": "#78385b", "css": "--fx-vino-glow", "usage": "Halos, inicio del degradado de enfriamiento. Nunca texto" },
    "line": { "value": "rgb(214 198 176 / 0.1)", "css": "--fx-line", "usage": "Divisores, bordes de panel" },
    "line-strong": { "value": "rgb(214 198 176 / 0.2)", "css": "--fx-line-strong", "usage": "Ghost, campos, tokens, encabezados de tabla, vidrio" },
    "error": { "value": "#a23a3a", "css": "--fx-error", "usage": "Solo ícono de alerta" },
    "success": { "value": "#4a7c59", "css": "--fx-success", "usage": "Reservado, sin uso actual" },
    "accent": { "value": "color-mix(in oklch, #78385b calc(var(--fx-heat) * 60%), #d6c6b0)", "css": "--fx-accent", "usage": "Marcas no textuales; heat = 1 - progreso * 1.1" }
  },
  "thermometer": {
    "planIndex": ["#78385b", "#8f506b", "#aa6a78", "#c09d94", "#d6c6b0"],
    "methodStations": ["#78385b", "#9a6a7a", "#b99a95", "#d6c6b0"],
    "cooling": "linear-gradient(90deg, #78385b, #d6c6b0)"
  },
  "gradient": {
    "metallic": "linear-gradient(135deg, #fff6eb 0%, #d6c6b0 45%, #9e8972 80%, #d6c6b0 100%)",
    "jeweler": ["#F6EFE4 0", "#D6C6B0 0.20", "#9B8770 0.46", "#C4B29A 0.56", "#F1E8DA 0.78", "#BFAC93 1"],
    "veilHero": "linear-gradient(90deg, rgb(11 10 12 / 0.92) 0%, rgb(11 10 12 / 0.7) 38%, rgb(11 10 12 / 0) 62%)",
    "veilStage": "linear-gradient(90deg, rgb(11 10 12 / 0.94) 0%, rgb(11 10 12 / 0.86) 38%, rgb(11 10 12 / 0.5) 64%, rgb(11 10 12 / 0.1) 100%)",
    "glowMax": "radial-gradient(closest-side, rgb(74 42 58 / 0.6), transparent)"
  },
  "font": {
    "sans": "\"Archivo Variable\", ui-sans-serif, system-ui, sans-serif",
    "mono": "\"IBM Plex Mono\", ui-monospace, monospace",
    "wordmark": "\"Orbitron\", \"Archivo Variable\", sans-serif"
  },
  "typography": {
    "display": { "size": "clamp(2.75rem, 5.7vw, 5.75rem)", "weight": 600, "lineHeight": 0.98, "letterSpacing": "-0.025em", "stretch": "86%" },
    "statement": { "size": "clamp(2.5rem, 5.8vw, 5.25rem)", "weight": 600, "lineHeight": 1, "letterSpacing": "-0.025em", "stretch": "86%" },
    "headline": { "size": "clamp(2.25rem, 4.6vw, 4rem)", "weight": 600, "lineHeight": 1.02, "letterSpacing": "-0.025em", "stretch": "86%" },
    "headline-sm": { "size": "clamp(2.25rem, 4.2vw, 3.5rem)", "weight": 600, "lineHeight": 1.04, "letterSpacing": "-0.025em", "stretch": "86%" },
    "title": { "size": "1.75rem / 2.125rem >= 768px", "weight": 600, "lineHeight": 1.1, "letterSpacing": "-0.015em", "stretch": "90%" },
    "title-modal": { "size": "1.875rem / 2.25rem >= 640px", "weight": 600, "lineHeight": 1.05, "letterSpacing": "-0.02em", "stretch": "88%" },
    "verb": { "size": "2rem", "weight": 600, "lineHeight": 1, "letterSpacing": "-0.015em", "stretch": "88%" },
    "after": { "size": "1.25rem / 1.5rem >= 768px", "weight": 500, "lineHeight": 1.375, "stretch": "94%" },
    "value": { "size": "21px", "weight": 400, "lineHeight": 1.375, "stretch": "94%" },
    "lede": { "size": "18px (hero 20px >= 640px)", "weight": 400, "lineHeight": 1.625, "color": "lila-muted" },
    "text": { "size": "17px", "lineHeight": 1.625, "color": "lila-muted" },
    "small": { "size": "16px", "lineHeight": 1.625, "color": "lila-muted" },
    "ui": { "size": "15px", "weight": 500, "lineHeight": 1 },
    "caption": { "size": "14px", "color": "lila-muted" },
    "fine": { "size": "13px", "color": "lila-muted" },
    "label": { "family": "mono", "sizes": ["13px", "12px", "11px"], "color": "lila-muted" },
    "logotype": { "family": "wordmark", "weight": 700, "size": { "sm": "14px", "md": "16px", "lg": "20px" }, "letterSpacing": { "sm": "0.2em", "md": "0.24em", "lg": "0.28em" }, "color": "champagne-light" },
    "plan-mark": {
      "family": "wordmark", "weight": 700, "transform": "uppercase", "lineHeight": 0.95, "fill": "gradient.metallic",
      "sizes": {
        "hero": { "size": "clamp(3.25rem, 6.6vw, 6.5rem)", "letterSpacing": "0.06em" },
        "branch": { "size": "clamp(2.5rem, 4.4vw, 4rem)", "letterSpacing": "0.08em" },
        "result": { "size": "1.5rem", "letterSpacing": "0.16em" },
        "stage": { "size": "15px", "letterSpacing": "0.2em" },
        "compare": { "size": "14px", "letterSpacing": "0.14em" },
        "index": { "size": "12px", "letterSpacing": "0.16em", "fill": "lila-muted / ink activo, sin degradado" }
      }
    },
    "price": { "weight": 600, "lineHeight": 0.9, "letterSpacing": "-0.03em", "numeric": "tabular-nums", "color": "champagne-light", "hero": "clamp(4rem, 8vw, 7.25rem)", "branch": "clamp(3rem, 5.2vw, 4.75rem)", "unit": "MXN/mes en mono 13-14px lila-muted" }
  },
  "priceStretch": { "basico": "62%", "plus": "78%", "pro": "94%", "advance": "110%", "max": "125%" },
  "spacing": {
    "fieldLabel": "8px", "buttonPair": "12px", "formFields": "20px", "headingToLede": "24px", "ledeToCta": "40px",
    "headerToContent": "64px-96px", "sectionY": "112px / 160px >= 768px"
  },
  "layout": { "container": "1400px", "gutter": { "base": "16px", "sm": "24px", "lg": "40px" }, "collapseBelow": "1024px", "headerHeight": "64px", "ledgerHeight": "40px", "measure": "34rem-38rem" },
  "radius": { "none": "0px" },
  "shadow": "none",
  "icons": { "library": "lucide", "strokeWidth": 1.5, "sizes": ["14px", "16px", "20px"] },
  "motion": { "ease": "cubic-bezier(0.16, 1, 0.3, 1)", "press": "120ms", "color": "200ms", "move": "300ms", "stage": "500ms-700ms", "enter": "600ms-800ms, opacity + 12-20px" },
  "zIndex": { "canvas": 0, "content": 10, "ledger": 20, "header": 30, "grain": 40, "modal": 50 }
}
